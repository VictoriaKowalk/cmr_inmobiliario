APP_NAME="Inmobiliaria"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://inmobiliaria.example.com
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cmr_inmobiliario
DB_USERNAME=cmr_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=true
QUEUE_FAILED_DRIVER=database-uuids

FILESYSTEM_DISK=local
FILESYSTEM_THROW=true

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=30
MAIL_FROM_ADDRESS=web@inmobiliaria.example.com
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_NOTIFICATIONS_ENABLED=true

IMAGEN_MAX_DIMENSION=2400
IMAGEN_CALIDAD_WEBP=82

BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=14
MYSQLDUMP_PATH=mysqldump

MAPAS_PROVEEDOR=openstreetmap
GOOGLE_MAPS_API_KEY=

BROADCAST_CONNECTION=log
VITE_APP_NAME="${APP_NAME}"
